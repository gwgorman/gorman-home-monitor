# Copy to ~/.config/home-monitor/runtime.env (mode 0600). Never commit it.
HOME_MONITOR_LAT=0.0
HOME_MONITOR_LON=0.0
HOME_MONITOR_LOCATION=ConfiguredLocation
HOME_MONITOR_TIMEZONE=UTC
HOME_MONITOR_KITCHEN_URL=http://kitchen.local:8765/api/dashboard
HOME_MONITOR_PIAWARE_BASES=http://piaware.local
HOME_MONITOR_LAN=127.0.0.0/8
HOME_MONITOR_HOSTS=localhost:8780,127.0.0.1:8780,office-monitor.local:8780
